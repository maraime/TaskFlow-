# 🔐 JWT Configuration (OBLIGATOIRE)
# ============================================
# Utilisé pour signer et vérifier les tokens JWT
# Générer une clé sécurisée: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=votre_cle_secrete_tres_longue_et_complexe

# ============================================
# 🗄️ MongoDB Configuration (OBLIGATOIRE)
# ============================================
# Pour Docker local: mongodb://localhost:27017/taskflow
# Pour MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net/taskflow
MONGODB_URI=mongodb://localhost:27017/taskflow

# ============================================
# 📧 Email Configuration (Optionnel - pour les invitations)
# ============================================
# Option 1: Ethereal (pour les tests - recommandé)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=votre_email@ethereal.email
EMAIL_PASSWORD=votre_mot_de_passe_ethereal
EMAIL_FROM=TaskFlow <noreply@ethereal.email>

# Option 2: Gmail (pour la production)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=votre_email@gmail.com
# EMAIL_PASSWORD=votre_app_password_16_caracteres
# EMAIL_FROM=TaskFlow <votre_email@gmail.com>

# ============================================
# 🚀 Server Configuration
# ============================================
PORT=5000
NODE_ENV=development